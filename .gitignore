##---------------------------------------------------------------------------------------- Node.js

# npm dependency tree — never commit; regenerated by npmInstall on every clean checkout.
node_modules/

# Lock file — ignored here so a fresh checkout uses 'npm install' instead of 'npm ci'.
# To switch to fully reproducible builds, remove this line, run
# ./gradlew :methodatlas-discovery-typescript:npmInstall once, and commit the generated
# methodatlas-discovery-typescript/package-lock.json.
package-lock.json

##---------------------------------------------------------------------------------------- Gradle
.gradle
**/build/
!src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Cache of project
.gradletasknamecache


# Ignore Gradle build output directory
build

# Default sidecar artefacts produced by optional CLI flags. Tests
# occasionally land them at the repo root when pitest mutates the
# output-path branch; ignore so they never get committed.
methodatlas-receipt.json
controls-coverage.json

methodatlas-credentials.csv
security-evidence-report.md
security-gap-report.json
security-tests.attestation.json

##---------------------------------------------------------------------------------------- Local tooling / assistant artefacts (never publish)
# AI-assisted / layered-delivery and review working files
.fabric/
.findings/
.claude/
CLAUDE.md
# Release commit-message drafts (wildcard — the version differs each release)
COMMIT_MSG*.txt
COMMIT_MSG*
# SABSA security-architecture library source and its doc-generation helper are kept
# local; only the rendered chapter under docs/sabsa/ is published. The leading
# slash anchors this to the repository root so it does NOT also match the
# published docs/sabsa/ and docs/images/sabsa/ directories.
/sabsa/
tools/sabsa-docs/

